# Define arquivos de texto padrão para usarem UTF-8 e quebras de linha LF (Linux/Docker/Vercel)
* text=auto eol=lf

# Força arquivos de configuração e código Python a serem estritamente tratados como texto UTF-8
*.py text working-tree-encoding=UTF-8
*.txt text working-tree-encoding=UTF-8
*.json text working-tree-encoding=UTF-8
*.yml text working-tree-encoding=UTF-8
*.yaml text working-tree-encoding=UTF-8
.env* text working-tree-encoding=UTF-8

# Garante que arquivos binários ou de mídia não sofram alterações de codificação
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.sqlite3 binary